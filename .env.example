# Copia este archivo como .env y cambia los valores para tu entorno local.
# No subas el archivo .env real a Git.

# MySQL (Docker Compose)
MYSQL_ROOT_PASSWORD=local_root_password_change_me
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=local_root_password_change_me
DB_NAME=peluqueria_selene

# Backend
NODE_ENV=development
PORT=3000
JWT_SECRET=replace_with_a_long_random_local_secret
JWT_EXPIRES_IN=7d
HOST=0.0.0.0

# PayPal: el proyecto usa simulación; no necesita credenciales reales.

# Docker / frontend
DOCKER_ENV=true
FRONTEND_URL=http://localhost,http://nginx
SERVER_IP=
